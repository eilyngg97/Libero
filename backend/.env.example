PORT=4000
# Conexion activa a MongoDB (legacy/fallback)
MONGO_URI=mongodb://localhost:27017/libero
# Conexion activa recomendada para rotacion
MONGO_URI_CURRENT=
# Conexion previa durante ventana de migracion
MONGO_URI_PREVIOUS=

# Secreto activo (legacy/fallback)
JWT_SECRET=replace-with-a-strong-random-secret
# Secreto activo recomendado para firma
JWT_SECRET_CURRENT=
# Secreto anterior para validar tokens emitidos antes de la rotacion
JWT_SECRET_PREVIOUS=

CORS_ORIGINS=http://localhost:3000

# Operacion
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
MONITOR_LATENCY_WARN_MS=1500
CRON_TIMEZONE=America/Caracas
