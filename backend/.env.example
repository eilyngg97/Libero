PORT=4000
# Conexion activa a MongoDB (legacy/fallback)
MONGO_URI=mongodb://localhost:27017/libero
# Conexion activa recomendada para rotacion
MONGO_URI_CURRENT=
# Conexion previa durante ventana de migracion
MONGO_URI_PREVIOUS=

# Secreto activo (legacy/fallback)
JWT_SECRET=replace-with-a-strong-random-secret
# Secreto activo recomendado para firma
JWT_SECRET_CURRENT=
# Secreto anterior para validar tokens emitidos antes de la rotacion
JWT_SECRET_PREVIOUS=

CORS_ORIGINS=http://localhost:3000

# Operacion
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
MONITOR_LATENCY_WARN_MS=1500
CRON_TIMEZONE=America/Caracas

# WhatsApp: prueba manual aislada, sin cron ni acceso a datos de academias.
WHATSAPP_TEST_ENABLED=false
# Copiar la version del ejemplo del panel de Meta (por ejemplo v25.0).
WHATSAPP_GRAPH_VERSION=
# Usar exclusivamente el Phone Number ID del NUMERO DE PRUEBA de Meta.
WHATSAPP_TEST_PHONE_NUMBER_ID=
# Secreto del backend. Nunca enviar al frontend ni guardar en Git.
WHATSAPP_ACCESS_TOKEN=
# Solo tu telefono autorizado como destinatario de prueba, con pais y sin +.
WHATSAPP_TEST_RECIPIENT=
# Nombre tecnico e idioma exactos de la plantilla del panel, no su titulo visible.
WHATSAPP_TEST_TEMPLATE=
WHATSAPP_TEST_LANGUAGE=
# Parametros de texto del cuerpo, en orden; [] para una plantilla sin parametros.
WHATSAPP_TEST_BODY_PARAMETERS=[]
